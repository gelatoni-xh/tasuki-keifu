generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas = ["public", "governance"]
}

/// 数据确认状态
enum DataStatus {
  verified
  pending
  conflicting
  missing

  @@schema("public")
}

/// 人物类型
enum PersonType {
  athlete
  coach
  staff

  @@schema("public")
}

/// 组织关系中的人物角色
enum MembershipRole {
  athlete
  coach
  staff

  @@schema("public")
}

/// 组织类型：高中、大学、实业团等统一在 Organization 表
enum OrganizationType {
  unknown
  junior_high_school
  high_school
  university
  prefecture_representative
  student_union_select
  corporate_team
  company
  club
  organizer

  @@schema("public")
}

/// 人物与组织之间的所属关系类型
enum MembershipType {
  origin
  enrolled
  affiliated
  graduated
  staff

  @@schema("public")
}

/// 名称变体类型
enum NameVariantType {
  official
  short
  kana
  romanized
  chinese
  english
  former
  media

  @@schema("public")
}

/// 数据来源类型
enum SourceType {
  university_official
  hakone_official
  ntv
  jaaf
  rikujokyogi_magazine
  data_site
  fan_site
  pdf
  manual

  @@schema("public")
}

/// 比赛项目类型
enum EventDiscipline {
  m800
  m1500
  m2000sc
  m3000
  m3000sc
  m5000
  m10000
  ten_mile
  half_marathon
  marathon
  ekiden_leg

  @@schema("public")
}

/// 赛事系列类型
enum CompetitionType {
  university_ekiden
  high_school_ekiden
  corporate_ekiden
  mixed_ekiden
  track_meet
  road_race
  marathon

  @@schema("public")
}

/// 审计动作类型
enum AuditAction {
  create
  update
  delete
  verify
  merge
  split

  @@schema("public")
}

/// 审计变更原因类型
enum AuditReasonType {
  initial_entry
  source_update
  source_correction
  stale_source
  manual_error
  format_normalization
  translation_update
  verification_update
  entity_merge
  entity_split
  import
  system

  @@schema("public")
}

/// 审计操作者类型
enum AuditActorType {
  admin
  import_script
  system

  @@schema("public")
}

/// 导入批次状态
enum ImportBatchStatus {
  pending
  running
  completed
  failed

  @@schema("public")
}

/// 人物/选手表：记录人本身的稳定信息
model Person {
  /// 主键
  id                   String         @id @default(cuid())
  /// URL 使用的稳定标识
  slug                 String         @unique
  /// 日文显示名
  displayNameJa        String
  /// 去空格后的日文检索名
  displayNameJaSearch  String         @default("")
  /// 日文读音
  displayNameKana      String?
  /// 罗马字显示名
  displayNameRoman     String?
  /// 中文显示名
  displayNameZh        String?
  /// 英文显示名
  displayNameEn        String?
  /// 出生日期
  birthDate            DateTime?
  /// 出身地
  hometown             String?
  /// 国籍
  nationality          String?
  /// 身高，单位 cm
  heightCm             Int?
  /// 体重，单位 kg
  weightKg             Int?
  /// 人物类型
  type                 PersonType     @default(athlete)
  /// 数据确认状态
  status               DataStatus     @default(pending)
  /// 备注
  notes                String?
  /// 创建时间
  createdAt            DateTime       @default(now())
  /// 更新时间
  updatedAt            DateTime       @updatedAt

  /// 所属履历
  memberships          Membership[]
  /// 当前 PB 快照
  personalBests        PersonalBest[]
  /// 比赛结果
  raceResults          RaceResult[]
  /// 名称变体
  nameVariants         NameVariant[]
  /// 外部来源映射
  sourceReferences     SourceReference[]
  /// 选手关系缓存
  playerRelationCache  PlayerRelationCache?

  @@index([status, updatedAt])
  @@index([type, status])
  @@index([hometown])

  @@schema("public")
}

/// 组织表：统一记录高中、大学、实业团、俱乐部等
model Organization {
  /// 主键
  id           String           @id @default(cuid())
  /// URL 使用的稳定标识
  slug         String           @unique
  /// 日文正式名
  nameJa       String
  /// 日文读音
  nameKana     String?
  /// 罗马字名称
  nameRoman    String?
  /// 中文名称
  nameZh       String?
  /// 英文名称
  nameEn       String?
  /// 简称
  shortName    String?
  /// 组织类型
  type         OrganizationType
  /// 所在地文本
  location     String?
  /// 都道府县
  prefecture   String?
  /// 国家代码
  country      String           @default("JP")
  /// 官方网站
  websiteUrl   String?
  /// 数据确认状态
  status       DataStatus       @default(pending)
  /// 备注
  notes        String?
  /// 创建时间
  createdAt    DateTime         @default(now())
  /// 更新时间
  updatedAt    DateTime         @updatedAt

  /// 与人物的所属履历
  memberships  Membership[]
  /// 代表该组织参赛的结果
  raceResults  RaceResult[]
  teamCompetitionResults TeamCompetitionResult[]
  /// 名称变体
  nameVariants NameVariant[]
  /// 外部来源映射
  sourceReferences SourceReference[]

  @@schema("public")
}

/// 所属履历表：记录人物在某时间段与某组织的关系
model Membership {
  /// 主键
  id             String         @id @default(cuid())
  /// 人物 ID
  personId       String
  /// 组织 ID
  organizationId String
  /// 所属关系类型
  type           MembershipType
  /// 日期依据：unknown / source / inferred；不从空日期推定当前所属
  startDateBasis String @default("unknown")
  endDateBasis   String @default("unknown")
  /// 结束状态：unknown / ongoing / ended
  endState       String @default("unknown")
  dateEvidence   Json?
  /// 只有明确互斥的职业关系才设置 employment / team_registration
  exclusivityGroup String?
  /// 开始日期；推算边界由 startDateBasis 标注
  startDate      DateTime?
  /// 结束日期；空值的语义由 endState 表达
  endDate        DateTime?
  /// 开始年份，便于查询
  startYear      Int?
  /// 结束年份，便于查询
  endYear        Int?
  /// 学部
  faculty        String?
  /// 学科
  department     String?
  /// 期/代
  cohort         String?
  /// 该段组织关系中的身份
  role           MembershipRole @default(athlete)
  /// 数据确认状态
  status         DataStatus     @default(pending)
  /// 备注
  notes          String?
  /// 来源 ID
  sourceId       String?
  /// 创建时间
  createdAt      DateTime       @default(now())
  /// 更新时间
  updatedAt      DateTime       @updatedAt

  /// 所属人物
  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// 所属组织
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 数据来源
  source         Source?        @relation(fields: [sourceId], references: [id])

  @@index([personId])
  @@index([organizationId])
  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@index([personId, organizationId])
  @@index([organizationId, personId])
  @@index([organizationId, startYear, endYear])
  @@index([personId, startDate, endDate])

  @@schema("public")
}

/// 当前 PB 快照表：V0.1 只保存各项目当前最好成绩
model PersonalBest {
  id              String          @id @default(cuid())
  personId        String
  discipline      EventDiscipline
  mark            String
  markMillis      Int?
  achievedOn      DateTime?
  competitionName String?
  venue           String?
  organizationId  String?
  stage           String?
  isHighSchoolPb  Boolean         @default(false)
  isCollegePb     Boolean         @default(false)
  status          DataStatus      @default(pending)
  notes           String?
  sourceId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  person          Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  source          Source?         @relation(fields: [sourceId], references: [id])

  @@index([personId])
  @@index([discipline])

  @@schema("public")
}

/// 赛事系列表，例如箱根駅伝、出雲駅伝、大阪マラソン
model Competition {
  id          String               @id @default(cuid())
  slug        String               @unique
  nameJa      String
  nameKana    String?
  nameRoman   String?
  nameZh      String?
  nameEn      String?
  type        CompetitionType?
  organizer   String?
  region      String?
  websiteUrl  String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  editions     CompetitionEdition[]
  nameVariants NameVariant[]
  sourceReferences SourceReference[]

  @@schema("public")
}

/// 赛事届次表，例如第102回箱根駅伝、大阪マラソン2025
model CompetitionEdition {
  id            String       @id @default(cuid())
  competitionId String
  slug          String       @unique
  editionNumber Int?
  year          Int
  officialName  String
  shortName     String?
  startsOn      DateTime?
  endsOn        DateTime?
  notes         String?
  sourceId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  source        Source?      @relation(fields: [sourceId], references: [id])
  races         Race[]
  teamCompetitionResults TeamCompetitionResult[]
  sourceReferences SourceReference[]

  @@index([competitionId])
  @@index([year])

  @@schema("public")
}

/// 队伍在某届赛事中的最终结果
model TeamCompetitionResult {
  id                   String                    @id @default(cuid())
  competitionEditionId String
  organizationId       String
  finalRank            Int?
  finalMark            String?
  finalMarkMillis      Int?
  status               DataStatus                @default(pending)
  notes                String?
  sourceId             String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  competitionEdition   CompetitionEdition        @relation(fields: [competitionEditionId], references: [id], onDelete: Cascade)
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source               Source?                   @relation(fields: [sourceId], references: [id])
  legSnapshots         TeamCompetitionLegSnapshot[]

  @@unique([competitionEditionId, organizationId])
  @@index([competitionEditionId, finalRank])
  @@index([organizationId, competitionEditionId])

  @@schema("public")
}

/// 队伍在第 N 区结束后的累计状态
model TeamCompetitionLegSnapshot {
  id                      String                 @id @default(cuid())
  teamCompetitionResultId String
  leg                     Int
  cumulativeRank          Int?
  cumulativeMark          String?
  cumulativeMarkMillis    Int?
  gapFromLeader           String?
  gapFromLeaderMillis     Int?
  status                  DataStatus             @default(pending)
  notes                   String?
  sourceId                String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  teamCompetitionResult   TeamCompetitionResult  @relation(fields: [teamCompetitionResultId], references: [id], onDelete: Cascade)
  source                  Source?                @relation(fields: [sourceId], references: [id])

  @@unique([teamCompetitionResultId, leg])
  @@index([leg, cumulativeRank])

  @@schema("public")
}

/// 比赛单元表：某届赛事下的具体区间、项目、组别
model Race {
  /// 主键
  id                   String              @id @default(cuid())
  /// 所属赛事届次 ID
  competitionEditionId String
  /// URL 或导入使用的稳定标识
  slug                 String              @unique
  /// 比赛单元名称，例如 5区、男子10000m 4組
  name                 String
  /// 比赛项目
  discipline           EventDiscipline
  /// 区间号，駅伝区间使用
  leg                  Int?
  /// 轮次，例如予選、決勝、タイムレース
  round                String?
  /// 组别，例如 4組
  heat                 String?
  /// 距离，单位米
  distanceMeters       Int?
  /// 开始时间
  startsAt             DateTime?
  /// 数据确认状态
  status               DataStatus          @default(pending)
  /// 备注
  notes                String?
  /// 来源 ID
  sourceId             String?
  /// 创建时间
  createdAt            DateTime            @default(now())
  /// 更新时间
  updatedAt            DateTime            @updatedAt

  /// 所属赛事届次
  competitionEdition   CompetitionEdition  @relation(fields: [competitionEditionId], references: [id], onDelete: Cascade)
  /// 数据来源
  source               Source?             @relation(fields: [sourceId], references: [id])
  /// 比赛结果
  raceResults          RaceResult[]
  /// 外部来源映射
  sourceReferences     SourceReference[]

  @@index([competitionEditionId])
  @@index([discipline])
  @@index([leg])
  @@index([competitionEditionId, leg, startsAt])
  @@index([competitionEditionId, startsAt])

  @@schema("public")
}

/// 比赛结果表：某个选手在某个 Race 中的成绩
model RaceResult {
  /// 主键
  id              String        @id @default(cuid())
  /// 人物 ID
  personId        String
  /// 比赛单元 ID
  raceId          String
  /// 比赛时所属组织 ID
  organizationId  String?
  /// 是否报名
  isEntry         Boolean       @default(false)
  /// 是否实际出场
  isStarter       Boolean       @default(false)
  /// 是否为当日変更
  isRaceDayChange Boolean       @default(false)
  /// 成绩文本
  mark            String?
  /// 成绩毫秒值，便于排序
  markMillis      Int?
  /// 名次，駅伝可表示区间名次，普通比赛表示该 race 内名次
  rank            Int?
  /// 团队名次
  teamRank        Int?
  /// 比赛时年级快照
  gradeAtRace     Int?
  /// 数据确认状态
  status          DataStatus    @default(pending)
  /// 备注，例如区間賞、区間新
  notes           String?
  /// 来源 ID
  sourceId        String?
  /// 创建时间
  createdAt       DateTime      @default(now())
  /// 更新时间
  updatedAt       DateTime      @updatedAt

  /// 所属人物
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// 所属比赛单元
  race            Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  /// 比赛时所属组织
  organization    Organization? @relation(fields: [organizationId], references: [id])
  /// 数据来源
  source          Source?       @relation(fields: [sourceId], references: [id])

  @@index([personId])
  @@index([raceId])
  @@index([organizationId])
  @@index([raceId, personId])
  @@index([personId, raceId])
  @@index([organizationId, personId])
  @@index([raceId, rank])
  @@index([raceId, markMillis])

  @@schema("public")
}

/// 选手关系缓存表：存储派生关系结果
model PlayerRelationCache {
  id          String   @id @default(cuid())
  personId    String   @unique
  payload     Json
  generatedAt DateTime @default(now())
  sourceHash  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([generatedAt])

  @@schema("public")
}

/// 缓存失效版本表：用于跨进程通知读缓存刷新
model CacheInvalidation {
  id        String   @id @default(cuid())
  scope     String   @unique
  version   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// 数据来源表
model Source {
  id           String        @id @default(cuid())
  name         String
  url          String?
  type         SourceType
  publishedOn  DateTime?
  accessedOn   DateTime?
  reliability  Int           @default(3)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships  Membership[]
  personalBests PersonalBest[]
  editions      CompetitionEdition[]
  races         Race[]
  raceResults   RaceResult[]
  teamCompetitionResults TeamCompetitionResult[]
  teamCompetitionLegSnapshots TeamCompetitionLegSnapshot[]
  nameVariants  NameVariant[]
  auditLogs     AuditLog[]
  sourceReferences SourceReference[]
  importBatches ImportBatch[]

  @@schema("public")
}

/// 名称变体表：正式名、简称、罗马字、翻译名等
model NameVariant {
  id              String          @id @default(cuid())
  value           String
  language        String?
  type            NameVariantType
  isPrimary       Boolean         @default(false)
  personId        String?
  organizationId  String?
  competitionId   String?
  sourceId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  person          Person?         @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competition     Competition?    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  source          Source?         @relation(fields: [sourceId], references: [id])

  @@index([value])
  @@index([personId])
  @@index([organizationId])
  @@index([competitionId])

  @@schema("public")
}

/// 审计日志表：记录数据维护行为，不记录现实世界事件
model AuditLog {
  id             String           @id @default(cuid())
  entityType     String
  entityId       String
  action         AuditAction
  fieldName      String?
  oldValue       Json?
  newValue       Json?
  reasonType     AuditReasonType
  reasonNote     String?
  sourceId       String?
  actorType      AuditActorType   @default(admin)
  actorId        String?
  batchId        String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  source         Source?          @relation(fields: [sourceId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
  @@index([reasonType])
  @@index([batchId])
  @@index([createdAt])

  @@schema("public")
}

/// 外部来源与内部实体之间的稳定映射
model SourceReference {
  id                  String              @id @default(cuid())
  sourceId            String
  sourceEntityType    String
  sourceEntityKey     String
  sourceUrl           String?
  personId            String?
  organizationId      String?
  competitionId       String?
  competitionEditionId String?
  raceId              String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  source              Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  person              Person?             @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competition         Competition?        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionEdition  CompetitionEdition? @relation(fields: [competitionEditionId], references: [id], onDelete: Cascade)
  race                Race?               @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceEntityType, sourceEntityKey])
  @@index([personId])
  @@index([organizationId])
  @@index([competitionId])
  @@index([competitionEditionId])
  @@index([raceId])

  @@schema("public")
}

/// 导入批次表：记录一次正式导入执行
model ImportBatch {
  id             String            @id @default(cuid())
  key            String            @unique
  type           String
  status         ImportBatchStatus @default(pending)
  sourceId       String?
  summary        String?
  payload        Json?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  source         Source?           @relation(fields: [sourceId], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdAt])

  @@schema("public")
}

/// 原始用户反馈；通知状态仅用于邮件送达与重试。
model UserFeedback {
  id                    String   @id @default(cuid())
  submissionKey         String   @unique
  payload               Json
  clientKey             String
  createdAt             DateTime @default(now())
  notificationStatus    String   @default("pending")
  notificationAttempts  Int      @default(0)
  notificationSentAt    DateTime?
  notificationLastError String?

  @@index([clientKey, createdAt])
  @@index([createdAt])
  @@index([notificationStatus, createdAt])

  @@schema("public")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model EventImportTask {
  batches       GovernanceBatch[]
  notifications NotificationDelivery[]
  id            String                 @id @default(uuid()) @db.Uuid
  requestKey    String                 @unique
  manifestHash  String
  mode          String
  status        String                 @default("queued")
  inputManifest Json
  summary       Json?
  leaseToken    String?
  leaseUntil    DateTime?              @db.Timestamptz(3)
  heartbeatAt   DateTime?              @db.Timestamptz(3)
  nextRunAt     DateTime               @default(now()) @db.Timestamptz(3)
  errorMessage  String?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?              @db.Timestamptz(3)

  @@index([status, nextRunAt, leaseUntil])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model GovernanceBatch {
  eventTask     EventImportTask        @relation(fields: [eventTaskId], references: [id], onDelete: Restrict)
  attempts      BatchAttempt[]
  findings      GovernanceFinding[]
  changes       GovernanceChange[]
  notifications NotificationDelivery[]
  id            String                 @id @default(uuid()) @db.Uuid
  eventTaskId   String                 @db.Uuid
  unitType      String
  unitKey       String
  sequence      Int
  rawPayloadRef String
  payloadHash   String
  payloadBytes  Int
  recordCount   Int
  status        String                 @default("queued")
  summary       Json?
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?              @db.Timestamptz(3)

  @@unique([eventTaskId, unitType, unitKey])
  @@unique([eventTaskId, sequence])
  @@index([eventTaskId, status])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model BatchAttempt {
  batch            GovernanceBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  executions       AgentExecution[]
  id               String           @id @default(uuid()) @db.Uuid
  batchId          String           @db.Uuid
  attemptNo        Int
  graphThreadId    String           @unique
  status           String           @default("running")
  inputFingerprint String
  metrics          Json?
  errorMessage     String?
  startedAt        DateTime         @default(now()) @db.Timestamptz(3)
  endedAt          DateTime?        @db.Timestamptz(3)

  @@unique([batchId, attemptNo])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model AgentExecution {
  attempt        BatchAttempt        @relation(fields: [batchAttemptId], references: [id], onDelete: Restrict)
  findings       GovernanceFinding[]
  changes        GovernanceChange[]
  id             String              @id @default(uuid()) @db.Uuid
  batchAttemptId String              @db.Uuid
  agentKey       String
  executionNo    Int                 @default(1)
  agentVersion   String
  status         String              @default("running")
  currentNode    String?
  resultSummary  Json?
  evidenceRefs   Json?
  metrics        Json?
  startedAt      DateTime            @default(now()) @db.Timestamptz(3)
  endedAt        DateTime?           @db.Timestamptz(3)

  @@unique([batchAttemptId, agentKey, executionNo])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model GovernanceFinding {
  batch              GovernanceBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  execution          AgentExecution? @relation(fields: [agentExecutionId], references: [id], onDelete: Restrict)
  id                 String          @id @default(uuid()) @db.Uuid
  batchId            String          @db.Uuid
  agentExecutionId   String?         @db.Uuid
  findingKey         String
  findingCode        String
  subjectRef         String
  severity           String
  resolutionStatus   String
  confidence         Float?
  reason             String
  detailsAndEvidence Json
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([batchId, findingKey])
  @@index([severity, resolutionStatus])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model GovernanceChange {
  batch                 GovernanceBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  execution             AgentExecution? @relation(fields: [proposedByExecutionId], references: [id], onDelete: Restrict)
  id                    String          @id @default(uuid()) @db.Uuid
  batchId               String          @db.Uuid
  proposedByExecutionId String?         @db.Uuid
  changeKey             String
  revision              Int             @default(1)
  idempotencyKey        String          @unique
  operation             String
  entityRef             String
  status                String          @default("planned")
  patchAndEvidence      Json
  businessAuditRef      String?
  errorMessage          String?
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  appliedAt             DateTime?       @db.Timestamptz(3)

  @@unique([batchId, changeKey, revision])
  @@index([batchId, entityRef, status])
  @@schema("governance")
}

/// 新版数据治理；迁移归主站，运行逻辑归 Agent
model NotificationDelivery {
  task          EventImportTask? @relation(fields: [eventTaskId], references: [id], onDelete: Restrict)
  batch         GovernanceBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  id            String           @id @default(uuid()) @db.Uuid
  eventTaskId   String?          @db.Uuid
  batchId       String?          @db.Uuid
  kind          String
  dedupeKey     String           @unique
  status        String           @default("pending")
  payload       Json
  attemptCount  Int              @default(0)
  nextAttemptAt DateTime         @default(now()) @db.Timestamptz(3)
  leaseToken    String?
  leaseUntil    DateTime?        @db.Timestamptz(3)
  sentAt        DateTime?        @db.Timestamptz(3)
  errorMessage  String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@schema("governance")
}
