[Unit]
Description=Submit updated Tasuki Keifu sitemap URLs to IndexNow
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /opt/apps/tasuki-keifu/indexnow/poll.py
StateDirectory=tasuki-keifu-indexnow
StateDirectoryMode=0750
TimeoutStartSec=10min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
